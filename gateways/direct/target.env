# Target "direct": k6 talks straight to the mock, no gateway. This is S1, the
# baseline every gateway is compared to. See gateways/README.md for the contract.
TARGET_DESCRIPTION="k6 straight to the mock upstream (baseline)"
# There is no gateway, so no profiles. The results directory uses "none".
TARGET_PROFILES="none"
# No compose overlay: the base stack (mock-llm) is all there is.
TARGET_COMPOSE_FILES=""
TARGET_BASE_URL="http://mock-llm:9000/v1"
TARGET_MODEL="mock-upstream"
TARGET_API_KEY="sk-gwbench"
TARGET_HEALTH_URL="http://mock-llm:9000/health"
TARGET_CONFIG_FILES=""
