# Target "bifrost": Bifrost HTTP gateway in front of the mock. See gateways/README.md for
# the contract and gateways/bifrost/README.md for the profiles.
TARGET_DESCRIPTION="Bifrost v2.5.1, minimal (no config store, no log store, no logging plugin) or prod (SQLite config and log stores, logging, governance with a virtual key and budget)"
TARGET_PROFILES="minimal prod"
TARGET_COMPOSE_FILES="gateways/bifrost/docker-compose.${PROFILE}.yml"
# Bifrost appends /v1/chat/completions to the provider base URL itself, so the provider's
# base_url in the config has no /v1. The k6 base URL does: the native route is
# POST /v1/chat/completions, and the model carries the provider prefix ("openai/...").
TARGET_BASE_URL="http://bifrost:8080/v1"
TARGET_MODEL="openai/mock-gpt"
# Local dummy keys. minimal: no auth is enforced (the value is ignored). prod: the virtual key
# that config.prod.json seeds (env BIFROST_VIRTUAL_KEY in the compose overlay), sent as Bearer.
case "$PROFILE" in
  prod) TARGET_API_KEY="sk-bf-gwbench-virtual" ;;
  *) TARGET_API_KEY="sk-gwbench-open" ;;
esac
TARGET_HEALTH_URL="http://bifrost:8080/health"
TARGET_CONFIG_FILES="gateways/bifrost/config.${PROFILE}.json gateways/bifrost/docker-compose.${PROFILE}.yml gateways/bifrost/datasheet/pricing.json gateways/bifrost/datasheet/model-parameters.json"
