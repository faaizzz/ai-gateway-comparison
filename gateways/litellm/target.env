# Target "litellm": LiteLLM proxy in front of the mock. See gateways/README.md for
# the contract and gateways/litellm/README.md for the profiles.
TARGET_DESCRIPTION="LiteLLM proxy v1.109.0, minimal (master key only) or prod (Postgres, Redis, virtual key with budget); S6/S7/S8 variants prod-langfuse, prod-rl, retry"
# minimal and prod are the S2 to S5 profiles; the others are the S6 to S8 variants (D28):
#   prod-langfuse  prod + the Langfuse callback, with the Langfuse stack as tracing backend (S6)
#   prod-rl        prod + rpm/tpm/parallel-request limits on the virtual key, never hit (S7)
#   retry          minimal + 2 retries (S8)
TARGET_PROFILES="minimal prod prod-rl prod-langfuse retry"
case "$PROFILE" in
  minimal) TARGET_COMPOSE_FILES="gateways/litellm/docker-compose.minimal.yml" ;;
  retry) TARGET_COMPOSE_FILES="gateways/litellm/docker-compose.minimal.yml gateways/litellm/docker-compose.retry.yml" ;;
  prod) TARGET_COMPOSE_FILES="gateways/litellm/docker-compose.prod.yml" ;;
  prod-rl) TARGET_COMPOSE_FILES="gateways/litellm/docker-compose.prod.yml gateways/litellm/docker-compose.prod-rl.yml" ;;
  prod-langfuse) TARGET_COMPOSE_FILES="gateways/litellm/docker-compose.prod.yml gateways/langfuse/compose.yml gateways/litellm/docker-compose.prod-langfuse.yml" ;;
esac
TARGET_BASE_URL="http://litellm:4000/v1"
TARGET_MODEL="mock-gpt"
# Local dummy keys. minimal/retry: the master key. prod*: a virtual key with a budget that
# the setup container creates (gateways/litellm/setup-key.py) with exactly this value.
case "$PROFILE" in
  prod*) TARGET_API_KEY="sk-gwbench-virtual" ;;
  *) TARGET_API_KEY="sk-gwbench-master" ;;
esac
TARGET_HEALTH_URL="http://litellm:4000/health/liveliness"
case "$PROFILE" in
  retry) TARGET_CONFIG_FILES="gateways/litellm/config.retry.yaml gateways/litellm/docker-compose.minimal.yml gateways/litellm/docker-compose.retry.yml" ;;
  prod-rl) TARGET_CONFIG_FILES="gateways/litellm/config.prod.yaml gateways/litellm/docker-compose.prod.yml gateways/litellm/docker-compose.prod-rl.yml" ;;
  prod-langfuse) TARGET_CONFIG_FILES="gateways/litellm/config.prod-langfuse.yaml gateways/litellm/docker-compose.prod.yml gateways/litellm/docker-compose.prod-langfuse.yml gateways/langfuse/compose.yml" ;;
  *) TARGET_CONFIG_FILES="gateways/litellm/config.${PROFILE}.yaml gateways/litellm/docker-compose.${PROFILE}.yml" ;;
esac
case "$PROFILE" in
  prod-langfuse)
    # The whole Langfuse stack (Web, worker, stores) starts as well: slow on a fresh volume.
    TARGET_SMOKE_TIMEOUT_S=180
    # S6: count the traces that reached the Langfuse backend (loss) and measure their lag.
    TARGET_POST_RUN="python3 gateways/langfuse/traces.py"
    TARGET_POST_RUN_FOR="s6"
    ;;
esac
