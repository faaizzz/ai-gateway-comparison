# Target "langfuse": self-hosted Langfuse (Web, worker, Postgres, ClickHouse, Redis, MinIO) and
# the Langfuse AI Gateway in front of the mock. See gateways/README.md for the contract and
# gateways/langfuse/README.md for the profiles.
TARGET_DESCRIPTION="Langfuse AI Gateway 4.78.0 with self-hosted Langfuse 4.78.0; minimal (ingestion mode NONE, no tracing) or prod (ingestion mode USAGE, traces to ClickHouse)"
# minimal = NONE, prod = USAGE (S2 to S5); full = FULL for S6 (same stack, same key, prompts and
# responses recorded too). The Langfuse gateway has no retries and no key rate limit (D28), so
# it has no retry and no rate-limit profile.
TARGET_PROFILES="minimal prod full"
TARGET_COMPOSE_FILES="gateways/langfuse/compose.yml"
# The gateway serves native OpenAI routes under /openai/v1 (Chat Completions, Responses) and
# /anthropic/v1; k6 posts to $TARGET_BASE_URL/chat/completions.
TARGET_BASE_URL="http://langfuse-ai-gateway:8080/openai/v1"
# Web routes a model to a connection by prefix: "gpt-*" goes to the OpenAI connection (or
# "<connection name>:<model>" picks one explicitly). The gateway forwards the name unchanged
# and the mock accepts any model.
TARGET_MODEL="gpt-mock"
# Local dummy key. It is a gateway key that langfuse-setup creates with exactly this secret
# (see gateways/langfuse/setup.mjs); it must match GATEWAY_KEY in compose.yml.
TARGET_API_KEY="sk-lf-gwbench-gateway-key"
TARGET_HEALTH_URL="http://langfuse-ai-gateway:8080/health"
# Everything under gwbench-langfuse-* plus the mock: the whole stack counts (contract rule 1).
TARGET_CONFIG_FILES="gateways/langfuse/compose.yml gateways/langfuse/clickhouse-low-memory.xml gateways/langfuse/setup.mjs"
# Profile -> ingestion mode of the gateway (langfuse-setup writes it into the organisation's
# gateway config). LANGFUSE_INGESTION_MODE=FULL is the S6 variant (prompts and responses
# recorded); an exported value from the caller wins.
case "$PROFILE" in
  prod) : "${LANGFUSE_INGESTION_MODE:=USAGE}" ;;
  full) : "${LANGFUSE_INGESTION_MODE:=FULL}" ;;
  *) : "${LANGFUSE_INGESTION_MODE:=NONE}" ;;
esac
export LANGFUSE_INGESTION_MODE
# The startup of the whole stack (migrations of Postgres and ClickHouse) is slow on a fresh volume.
TARGET_SMOKE_TIMEOUT_S=180
# S6: count the traces that reached ClickHouse (loss) and measure their lag after the run.
TARGET_POST_RUN="python3 gateways/langfuse/traces.py"
TARGET_POST_RUN_FOR="s6"
