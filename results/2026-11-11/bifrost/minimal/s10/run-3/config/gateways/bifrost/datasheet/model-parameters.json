{
  "mock-gpt": {
    "input_cost_per_token": 1e-06,
    "output_cost_per_token": 2e-06,
    "max_input_tokens": 128000,
    "max_output_tokens": 16384,
    "max_tokens": 16384,
    "mode": "chat",
    "supports_system_messages": true,
    "provider": "openai",
    "base_model": "mock-gpt",
    "model_parameters": [
      {
        "id": "temperature",
        "label": "Temperature",
        "helpText": "Sampling temperature.",
        "type": "number",
        "default": 1,
        "range": { "min": 0, "max": 2, "step": 0.01 }
      },
      {
        "id": "max_tokens",
        "label": "Max Tokens",
        "helpText": "Maximum number of tokens to generate.",
        "type": "number",
        "default": 2048,
        "range": { "min": 1, "max": 16384 }
      }
    ]
  }
}
