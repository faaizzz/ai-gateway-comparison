{
  "uid": "gwbench-overview",
  "title": "gwbench overview",
  "tags": [
    "gwbench"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gwbench-prometheus"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes{name=~\"gwbench-.*\"}, name)",
          "refId": "c"
        },
        "definition": "label_values(container_memory_working_set_bytes{name=~\"gwbench-.*\"}, name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "gwbench-.*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "k6",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "gwbench-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwbench-prometheus"
          },
          "refId": "A",
          "expr": "rate(k6_http_reqs_total[10s])",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Virtual users",
      "datasource": {
        "type": "prometheus",
        "uid": "gwbench-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwbench-prometheus"
          },
          "refId": "A",
          "expr": "k6_vus",
          "legendFormat": "vus"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwbench-prometheus"
          },
          "refId": "B",
          "expr": "k6_vus_max",
          "legendFormat": "vus max"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request duration (http_req_duration)",
      "datasource": {
        "type": "prometheus",
        "uid": "gwbench-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwbench-prometheus"
          },
          "refId": "A",
          "expr": "k6_http_req_duration_p50",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwbench-prometheus"
          },
          "refId": "B",
          "expr": "k6_http_req_duration_p95",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwbench-prometheus"
          },
          "refId": "C",
          "expr": "k6_http_req_duration_p99",
          "legendFormat": "p99"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwbench-prometheus"
          },
          "refId": "D",
          "expr": "k6_http_req_duration_max",
          "legendFormat": "max"
        }
      ],
      "description": "Percentiles as k6 reports them per push interval. For SSE requests this is the whole stream, not time to first token."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Streaming time to first token (stream_ttft_ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "gwbench-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwbench-prometheus"
          },
          "refId": "A",
          "expr": "k6_stream_ttft_ms_p50",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwbench-prometheus"
          },
          "refId": "B",
          "expr": "k6_stream_ttft_ms_p95",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwbench-prometheus"
          },
          "refId": "C",
          "expr": "k6_stream_ttft_ms_p99",
          "legendFormat": "p99"
        }
      ],
      "description": "Custom Trend stream_ttft_ms, measured in the k6 script as time to the first SSE data event."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failed requests",
      "datasource": {
        "type": "prometheus",
        "uid": "gwbench-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwbench-prometheus"
          },
          "refId": "A",
          "expr": "k6_http_req_failed_rate",
          "legendFormat": "http_req_failed rate"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwbench-prometheus"
          },
          "refId": "B",
          "expr": "1 - k6_checks_rate",
          "legendFormat": "failed checks"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "SSE events",
      "datasource": {
